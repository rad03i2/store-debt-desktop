<Window x:Class="StoreDebt.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="دفتر ديون المحل"
        Width="1440"
        Height="900"
        MinWidth="1100"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        Background="{StaticResource BackgroundBrush}">

    <Window.InputBindings>
        <KeyBinding Modifiers="Ctrl" Key="N" Command="{Binding ShowAddCustomerCommand}"/>
        <KeyBinding Key="F2" Command="{Binding ShowDebtCommand}"/>
        <KeyBinding Key="F3" Command="{Binding ShowPaymentCommand}"/>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}"/>
    </Window.InputBindings>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource PrimaryDarkBrush}">
            <Grid Margin="18,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="32"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <Border Width="54" Height="54" CornerRadius="18" Background="#26FFFFFF"
                            HorizontalAlignment="Right">
                        <TextBlock Text="د" FontSize="27" FontWeight="Bold" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="دفتر المحل" Foreground="White" FontSize="24"
                               FontWeight="Bold" Margin="0,12,0,2"/>
                    <TextBlock Text="إدارة الديون والحسابات" Foreground="#BDE2D0" FontSize="12"/>
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <Border Background="#22FFFFFF" CornerRadius="10" Padding="12,11" Margin="0,0,0,8">
                        <TextBlock Text="الرئيسية" Foreground="White" FontWeight="SemiBold"/>
                    </Border>
                    <Border CornerRadius="10" Padding="12,11" Margin="0,0,0,8">
                        <TextBlock Text="الزبائن" Foreground="#CFE5D8"/>
                    </Border>
                    <Border CornerRadius="10" Padding="12,11">
                        <TextBlock Text="سجل الحركات" Foreground="#CFE5D8"/>
                    </Border>
                </StackPanel>

                <Border Grid.Row="4" Background="#16FFFFFF" CornerRadius="12" Padding="12">
                    <StackPanel>
                        <TextBlock Text="المرحلة الأولى" Foreground="White"
                                   FontWeight="Bold" FontSize="12"/>
                        <TextBlock Text="الإصدار 0.1.0" Foreground="#BDE2D0"
                                   FontSize="11" Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Main area -->
        <Grid Grid.Column="1" Margin="28,22,28,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="72"/>
                <RowDefinition Height="118"/>
                <RowDefinition Height="18"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="44"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="إدارة حسابات الزبائن" FontSize="25" FontWeight="Bold"/>
                    <TextBlock Text="{Binding TodayText}" Margin="0,5,0,0"
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Content="تحديث  F5" Command="{Binding RefreshCommand}"
                            Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
                    <Button Content="+ زبون جديد   Ctrl+N" Command="{Binding ShowAddCustomerCommand}"
                            Style="{StaticResource PrimaryButton}"/>
                </StackPanel>
            </Grid>

            <!-- Metrics -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="White" CornerRadius="16"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="20">
                    <StackPanel>
                        <TextBlock Text="إجمالي الديون" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding TotalDebtText}" FontSize="28" FontWeight="Bold"
                                   Foreground="{StaticResource DebtBrush}" Margin="0,8,0,0"/>
                        <TextBlock Text="المبالغ المطلوبة من جميع الزبائن" FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="White" CornerRadius="16"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="20">
                    <StackPanel>
                        <TextBlock Text="تحصيلات اليوم" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding TodayCollectionsText}" FontSize="28" FontWeight="Bold"
                                   Foreground="{StaticResource PaymentBrush}" Margin="0,8,0,0"/>
                        <TextBlock Text="مجموع التسديدات المسجلة اليوم" FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="4" Background="White" CornerRadius="16"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="20">
                    <StackPanel>
                        <TextBlock Text="عدد الزبائن" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding CustomerCountText}" FontSize="28" FontWeight="Bold"
                                   Margin="0,8,0,0"/>
                        <TextBlock Text="حسابات الزبائن المسجلة" FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Customer list + details -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="400"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Customer list -->
                <Border Grid.Column="0" Background="White" CornerRadius="16"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <Grid Margin="18">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <TextBlock Text="الزبائن" FontSize="19" FontWeight="Bold"/>
                            <TextBlock Text="{Binding CustomerCountText}"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                        </Grid>

                        <TextBox Grid.Row="2"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="ابحث بالاسم أو الهاتف أو العنوان"
                                 Height="42"/>

                        <ListBox Grid.Row="4"
                                 ItemsSource="{Binding Customers}"
                                 SelectedItem="{Binding SelectedCustomer}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,0,0,7"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="11" Background="#F8FAF9"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1" Padding="12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="44"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0" Width="38" Height="38"
                                                    CornerRadius="19" Background="#E2F2E9">
                                                <TextBlock Text="ش" FontWeight="Bold"
                                                           Foreground="{StaticResource PrimaryBrush}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>

                                            <StackPanel Grid.Column="1" Margin="10,0,10,0">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                           FontSize="14" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding ContactText}" FontSize="11"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           Margin="0,4,0,0"/>
                                            </StackPanel>

                                            <TextBlock Grid.Column="2" Text="{Binding DebtText}"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource DebtBrush}"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <!-- Customer details -->
                <Border Grid.Column="2" Background="White" CornerRadius="16"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <Grid Margin="22">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="18"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="18"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="18"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="حساب الزبون" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding SelectedCustomerName}"
                                           FontSize="23" FontWeight="Bold" Margin="0,3,0,0"/>
                                <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                    <TextBlock Text="{Binding SelectedCustomerPhone}"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Text="  •  " Foreground="#B0B7B3"/>
                                    <TextBlock Text="{Binding SelectedCustomerAddress}"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="1" HorizontalAlignment="Left">
                                <TextBlock Text="الدين الحالي" FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           HorizontalAlignment="Left"/>
                                <TextBlock Text="{Binding SelectedCustomerDebtText}"
                                           FontSize="27" FontWeight="Bold"
                                           Foreground="{StaticResource DebtBrush}"
                                           HorizontalAlignment="Left" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Content="+ إضافة دين   F2"
                                    Command="{Binding ShowDebtCommand}"
                                    Style="{StaticResource DangerButton}"/>
                            <Button Grid.Column="2" Content="تسجيل تسديد   F3"
                                    Command="{Binding ShowPaymentCommand}"
                                    Style="{StaticResource PrimaryButton}"/>
                        </Grid>

                        <Grid Grid.Row="4">
                            <TextBlock Text="سجل الحساب" FontSize="17" FontWeight="Bold"/>
                            <TextBlock Text="الأحدث أولاً" HorizontalAlignment="Left"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="11" VerticalAlignment="Center"/>
                        </Grid>

                        <ScrollViewer Grid.Row="6" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Transactions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#FAFBFA" CornerRadius="11"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="1" Padding="13" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding TypeText}"
                                                                   FontWeight="Bold"/>
                                                        <TextBlock Text="   "/>
                                                        <TextBlock Text="{Binding DateTimeText}"
                                                                   FontSize="11"
                                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding ItemsSummary}"
                                                               Margin="0,5,0,0" FontSize="12"/>
                                                    <TextBlock Text="{Binding Note}"
                                                               Margin="0,3,0,0" FontSize="11"
                                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="1" Margin="20,0,0,0">
                                                    <TextBlock Text="{Binding AmountText}"
                                                               FontSize="16" FontWeight="Bold"
                                                               HorizontalAlignment="Left"/>
                                                    <TextBlock Text="{Binding BalanceText}"
                                                               FontSize="10"
                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                               HorizontalAlignment="Left"
                                                               Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- Status bar -->
            <Border Grid.Row="4" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,0" Margin="0,8,0,0">
                <Grid Margin="2,9,2,0">
                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="11"/>
                    <TextBlock Text="SQLite محلي • بدون إنترنت"
                               HorizontalAlignment="Left"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="11"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Add customer overlay -->
        <Grid Grid.ColumnSpan="2"
              Visibility="{Binding IsAddCustomerOpen, Converter={StaticResource BoolToVisibilityConverter}}"
              Background="#72000000">
            <Border Width="540" Background="White" CornerRadius="18" Padding="26"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="إضافة زبون جديد" FontSize="23" FontWeight="Bold"/>
                    <TextBlock Text="أنشئ حساباً جديداً للزبون"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,4,0,18"/>

                    <TextBlock Text="اسم الزبون *" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding CustomerNameInput, UpdateSourceTrigger=PropertyChanged}"
                             Height="42"/>

                    <TextBlock Text="رقم الهاتف" FontWeight="SemiBold" Margin="0,14,0,6"/>
                    <TextBox Text="{Binding CustomerPhoneInput}" Height="42"/>

                    <TextBlock Text="العنوان" FontWeight="SemiBold" Margin="0,14,0,6"/>
                    <TextBox Text="{Binding CustomerAddressInput}" Height="42"/>

                    <TextBlock Text="ملاحظات" FontWeight="SemiBold" Margin="0,14,0,6"/>
                    <TextBox Text="{Binding CustomerNotesInput}" Height="70"
                             AcceptsReturn="True" TextWrapping="Wrap"/>

                    <Grid Margin="0,22,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="حفظ الزبون"
                                Command="{Binding SaveCustomerCommand}"
                                Style="{StaticResource PrimaryButton}"/>
                        <Button Grid.Column="2" Content="إلغاء"
                                Command="{Binding CancelDialogCommand}"
                                Style="{StaticResource SecondaryButton}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Debt overlay -->
        <Grid Grid.ColumnSpan="2"
              Visibility="{Binding IsDebtOpen, Converter={StaticResource BoolToVisibilityConverter}}"
              Background="#72000000">
            <Border Width="590" Background="White" CornerRadius="18" Padding="26"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="تسجيل دين جديد" FontSize="23" FontWeight="Bold"/>
                    <TextBlock Text="{Binding SelectedCustomerName}"
                               Foreground="{StaticResource DebtBrush}"
                               FontWeight="SemiBold" Margin="0,4,0,18"/>

                    <TextBlock Text="المبلغ (دينار عراقي) *" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding DebtAmountInput, UpdateSourceTrigger=PropertyChanged}"
                             Height="48" FontSize="20" FontWeight="Bold"/>

                    <UniformGrid Columns="6" Margin="0,10,0,0">
                        <Button Content="500" Command="{Binding SetDebtAmountCommand}" CommandParameter="500"
                                Style="{StaticResource SecondaryButton}" Margin="2"/>
                        <Button Content="1,000" Command="{Binding SetDebtAmountCommand}" CommandParameter="1000"
                                Style="{StaticResource SecondaryButton}" Margin="2"/>
                        <Button Content="2,000" Command="{Binding SetDebtAmountCommand}" CommandParameter="2000"
                                Style="{StaticResource SecondaryButton}" Margin="2"/>
                        <Button Content="3,000" Command="{Binding SetDebtAmountCommand}" CommandParameter="3000"
                                Style="{StaticResource SecondaryButton}" Margin="2"/>
                        <Button Content="4,000" Command="{Binding SetDebtAmountCommand}" CommandParameter="4000"
                                Style="{StaticResource SecondaryButton}" Margin="2"/>
                        <Button Content="5,000" Command="{Binding SetDebtAmountCommand}" CommandParameter="5000"
                                Style="{StaticResource SecondaryButton}" Margin="2"/>
                    </UniformGrid>

                    <TextBlock Text="تفاصيل المشتريات" FontWeight="SemiBold" Margin="0,14,0,6"/>
                    <TextBox Text="{Binding DebtItemsInput}" Height="68"
                             AcceptsReturn="True" TextWrapping="Wrap"/>

                    <TextBlock Text="ملاحظة" FontWeight="SemiBold" Margin="0,14,0,6"/>
                    <TextBox Text="{Binding DebtNoteInput}" Height="42"/>

                    <Grid Margin="0,22,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="تأكيد تسجيل الدين"
                                Command="{Binding SaveDebtCommand}"
                                Style="{StaticResource DangerButton}"/>
                        <Button Grid.Column="2" Content="إلغاء"
                                Command="{Binding CancelDialogCommand}"
                                Style="{StaticResource SecondaryButton}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Payment overlay -->
        <Grid Grid.ColumnSpan="2"
              Visibility="{Binding IsPaymentOpen, Converter={StaticResource BoolToVisibilityConverter}}"
              Background="#72000000">
            <Border Width="560" Background="White" CornerRadius="18" Padding="26"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="تسجيل تسديد" FontSize="23" FontWeight="Bold"/>
                    <TextBlock Text="{Binding SelectedCustomerName}"
                               Foreground="{StaticResource PaymentBrush}"
                               FontWeight="SemiBold" Margin="0,4,0,18"/>

                    <TextBlock Text="المبلغ المستلم *" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding PaymentAmountInput, UpdateSourceTrigger=PropertyChanged}"
                             Height="48" FontSize="20" FontWeight="Bold"/>

                    <UniformGrid Columns="5" Margin="0,10,0,0">
                        <Button Content="500" Command="{Binding SetPaymentAmountCommand}" CommandParameter="500"
                                Style="{StaticResource SecondaryButton}" Margin="2"/>
                        <Button Content="1,000" Command="{Binding SetPaymentAmountCommand}" CommandParameter="1000"
                                Style="{StaticResource SecondaryButton}" Margin="2"/>
                        <Button Content="2,000" Command="{Binding SetPaymentAmountCommand}" CommandParameter="2000"
                                Style="{StaticResource SecondaryButton}" Margin="2"/>
                        <Button Content="5,000" Command="{Binding SetPaymentAmountCommand}" CommandParameter="5000"
                                Style="{StaticResource SecondaryButton}" Margin="2"/>
                        <Button Content="10,000" Command="{Binding SetPaymentAmountCommand}" CommandParameter="10000"
                                Style="{StaticResource SecondaryButton}" Margin="2"/>
                    </UniformGrid>

                    <TextBlock Text="ملاحظة التسديد" FontWeight="SemiBold" Margin="0,14,0,6"/>
                    <TextBox Text="{Binding PaymentNoteInput}" Height="58"
                             AcceptsReturn="True" TextWrapping="Wrap"/>

                    <Grid Margin="0,22,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="تأكيد التسديد"
                                Command="{Binding SavePaymentCommand}"
                                Style="{StaticResource PrimaryButton}"/>
                        <Button Grid.Column="2" Content="إلغاء"
                                Command="{Binding CancelDialogCommand}"
                                Style="{StaticResource SecondaryButton}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
